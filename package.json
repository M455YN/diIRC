    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "autoprefixer": "^10.4.15",
    "bumpp": "^12.2.1",
    "chai": "^6.2.2",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "webdriverio": "^9.31.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
